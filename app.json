{
  "expo": {
    "name": "PTRLogger",
    "slug": "trackwell",
    "scheme": "trackwell",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "imageWidth": 230,
      "resizeMode": "contain",
      "backgroundColor": "#0F1419"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gurrasv.naphabapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true,
        "NSLocationWhenInUseUsageDescription": "Plats behovs for att spåra ditt utepass med karta, tid och fart.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Bakgrundsplats behovs for att fortsatta spårning nar skarmen ar last.",
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F1419"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.gurrasv.naphabapp",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withNativeAndroidNotifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 230,
          "resizeMode": "contain",
          "backgroundColor": "#0F1419"
        }
      ],
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Plats behovs for att spåra ditt utepass.",
          "locationAlwaysAndWhenInUsePermission": "Bakgrundsplats behovs for att fortsatta spårning nar skarmen ar last.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      "@maplibre/maplibre-react-native"
    ],
    "extra": {
      "appVariant": "preview",
      "eas": {
        "projectId": "ece6c3f6-9eb8-4ee7-9695-9c50b6bde252"
      }
    },
    "owner": "gurrasv"
  }
}
